{
  "name": "@nimble-way/eve",
  "version": "0.1.1",
  "description": "Nimble Web Search and Extract as an extension for Vercel's eve agent framework.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Nimble",
  "homepage": "https://github.com/Nimbleway/eve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nimbleway/eve.git"
  },
  "bugs": {
    "url": "https://github.com/Nimbleway/eve/issues"
  },
  "keywords": [
    "nimble",
    "eve",
    "eve-extension",
    "vercel",
    "agent",
    "web-search",
    "search",
    "extract",
    "tool",
    "llm"
  ],
  "sideEffects": false,
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "prepare": "eve extension build",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nimble-way/nimble-js": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "0.38.3",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "eve": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
